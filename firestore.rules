rules_version = '2';

// Beveiligingsregels voor HUB Game Studio.
// De sleutel in het HTML-bestand is publiek; DIT bestand beschermt je data.
service cloud.firestore {
  match /databases/{database}/documents {

    // een tijdstempel moet ongeveer 'nu' zijn, anders kan iemand de rem omzeilen
    function versTijdstip() {
      return request.resource.data.t is number
          && request.resource.data.t <= request.time.toMillis() + 300000
          && request.resource.data.t >= request.time.toMillis() - 300000;
    }

    function geldigeSpeler() {
      return request.resource.data.keys().hasOnly(['name','t','msgs','runs','coins','look','owned'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 22
          && request.resource.data.msgs is list
          && request.resource.data.msgs.size() <= 24
          && request.resource.data.runs is list
          && request.resource.data.runs.size() <= 120
          && (!('coins' in request.resource.data.keys())
              || (request.resource.data.coins is number
                  && request.resource.data.coins >= 0
                  && request.resource.data.coins <= 1000000))
          && versTijdstip();
    }

    // Elke speler schrijft alleen zijn eigen document; iedereen mag alles lezen.
    match /players/{uid} {
      allow read:   if true;
      allow create: if request.auth != null && request.auth.uid == uid && geldigeSpeler();
      // minstens een halve seconde tussen twee schrijfacties: een rem op spammen
      allow update: if request.auth != null && request.auth.uid == uid && geldigeSpeler()
                    && request.resource.data.t >= resource.data.t + 500;
      allow delete: if false;
    }

    // Wie er nu rondloopt. Elke 20 seconden ververst, verdwijnt vanzelf.
    match /presence/{uid} {
      allow read:   if true;
      allow write:  if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name','world','t'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 22
                    && versTijdstip();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // verder niets
    match /{document=**} { allow read, write: if false; }
  }
}
